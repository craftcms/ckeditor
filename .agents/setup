#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
export CI=true COMPOSER_NO_INTERACTION=1
TIMEFORMAT='Finished in %3R seconds'

step() {
    printf '\n==> %s\n' "$1"
    shift
    time "$@"
}

scratch=$(mktemp -d)
trap 'rm -rf -- "$scratch"' EXIT

# Read the PHP and Node versions from the checked-out branch, so this script
# keeps working when it's merged into 6.x (PHP 8.5, Node 22).
php_version=$(jq -r '.config.platform.php // .require.php' composer.json | grep -oE '[0-9]+\.[0-9]+' | head -1)
node_major=$(tr -d '[:space:]v' < .nvmrc | cut -d. -f1)

# Debian's PHP doesn't match the plugin's versions. Use the upstream Sury packages.
. /etc/os-release
if [[ ! -f /usr/share/keyrings/debsuryorg-archive-keyring.gpg ]]; then
    curl -fsSL https://packages.sury.org/debsuryorg-archive-keyring.deb -o "$scratch/sury.deb"
    sudo dpkg -i "$scratch/sury.deb"
fi
echo "deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ $VERSION_CODENAME main" |
    sudo tee /etc/apt/sources.list.d/php.list >/dev/null

packages=(unzip)
for ext in cli bcmath curl gd intl mbstring sqlite3 xml zip; do
    packages+=("php$php_version-$ext")
done
missing=()
for package in "${packages[@]}"; do
    if [[ $(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true) != 'install ok installed' ]]; then
        missing+=("$package")
    fi
done
if ((${#missing[@]})); then
    step 'Refresh apt indexes' sudo apt-get update -qq
    step "Install PHP $php_version" sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi
sudo update-alternatives --set php "/usr/bin/php$php_version"

if ! command -v composer >/dev/null; then
    curl -fsSL https://getcomposer.org/installer -o "$scratch/composer-setup.php"
    expected=$(curl -fsSL https://composer.github.io/installer.sig)
    actual=$(php -r 'echo hash_file("sha384", $argv[1]);' "$scratch/composer-setup.php")
    [[ $actual == "$expected" ]] || { echo 'Composer installer checksum mismatch' >&2; exit 1; }
    php "$scratch/composer-setup.php" --2 --install-dir="$scratch" --filename=composer
    sudo install -m 755 "$scratch/composer" /usr/local/bin/composer
fi

# Install the Node major pinned in .nvmrc (CI's version) to the standard PATH,
# so later non-interactive shells see it. Unpacking over the base image's Node
# leaves its npm modules behind unless they're removed first; `npm ls` detects that.
if [[ $(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || true) != "$node_major" ]] ||
    ! npm ls --global --depth=0 >/dev/null 2>&1; then
    case $(uname -m) in
        x86_64) node_arch=x64 ;;
        aarch64) node_arch=arm64 ;;
        *) echo 'Unsupported Node architecture' >&2; exit 1 ;;
    esac
    curl -fsSL "https://nodejs.org/dist/latest-v${node_major}.x/SHASUMS256.txt" -o "$scratch/SHASUMS256.txt"
    archive=$(awk -v arch="linux-$node_arch.tar.xz" '$2 ~ arch "$" {print $2}' "$scratch/SHASUMS256.txt")
    curl -fsSL "https://nodejs.org/dist/latest-v${node_major}.x/$archive" -o "$scratch/$archive"
    (cd "$scratch" && grep " $archive$" SHASUMS256.txt | sha256sum --check)
    sudo rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack
    step "Install Node $node_major" sudo tar -xJf "$scratch/$archive" -C /usr/local --strip-components=1
fi

step 'Install PHP dependencies' composer install --prefer-dist --no-progress

# npm ci always reinstalls from scratch, so skip it while the lockfile is unchanged.
if [[ ! -f node_modules/.package-lock.json || package-lock.json -nt node_modules/.package-lock.json ]]; then
    step 'Install frontend dependencies' npm ci --no-audit --no-fund
fi

guidance_marker='# CKEditor orb'
if ! grep -Fqx "$guidance_marker" ~/.config/amp/AGENTS.md 2>/dev/null; then
    mkdir -p ~/.config/amp
    cat >> ~/.config/amp/AGENTS.md <<EOF

$guidance_marker

- PHP, Composer and Node are installed at the versions in \`composer.json\` and \`.nvmrc\`, and Composer and npm dependencies are ready. If you check out a branch with different versions, rerun \`.agents/setup\`.
- CI checks: \`composer check-cs\`, \`composer phpstan\` and \`npx prettier --check .\`.
- Rebuild the committed JS bundles with \`npm run build\` after editing their \`src/\` files.
EOF
fi

printf '\nOrb toolchain and dependencies are ready.\n'
