{#
 # The toolbar builder, config options and custom styles settings for a CKEditor field.
 #
 # Rendered for the `ckeditor:editor-config` UI control, which initializes the JavaScript.
 # Element IDs are namespaced with the control’s container ID, so several instances can coexist.
 #}
{% import '_includes/forms.twig' as forms %}

{% set readOnly = readOnly ?? false %}

{% embed '_includes/forms/field.twig' with {
  label: 'Toolbar'|t('ckeditor'),
  instructions: 'Drag toolbar items into the editor.'|t('ckeditor'),
  id: 'toolbar-field'|namespaceInputId,
} %}
  {% block input %}
  <div style="min-width: 0; width: 100%;">
    <div id="{{ 'toolbar-builder'|namespaceInputId }}" class="ckeditor-tb pane{{ readOnly ? ' disabled' : '' }}" data-available-items="{{ toolbarItems|json_encode }}">
      <div class="ck ck-reset_all">
        <div class="ckeditor-tb--items ckeditor-tb--source ck ck-reset ck-editor ck-rounded-corners">
          <div class="ck ck-toolbar">
            <div class="ck ck-toolbar__items"></div>
          </div>
        </div>

        <div class="ckeditor-tb--items ckeditor-tb--target ck ck-reset ck-editor ck-rounded-corners">
          <div class="ck ck-editor__top">
            <div class="ck ck-toolbar">
              <div class="ck ck-toolbar__items"></div>
            </div>
          </div>
          <div class="ck ck-editor__main">
            <div class="ck ck-content ck-editor__editable ck-editor__editable_inline"></div>
          </div>
        </div>
      </div>

      {{ hiddenInput('toolbar', field.toolbar|json_encode) }}
    </div>
  
  </div>
  {% endblock %}
{% endembed %}

{% embed '_includes/forms/field.twig' with {
  label: 'Config Options'|t('ckeditor'),
  instructions: 'Define custom [config options]({link}) which should be merged with the default config.'|t('ckeditor', {
    link: 'https://ckeditor.com/docs/ckeditor5/latest/api/module_core_editor_editorconfig-EditorConfig.html',
  }),
  id: 'config-options-field'|namespaceInputId,
} %}
  {% block input %}
  <div style="min-width: 0; width: 100%;">
      {% import '_includes/forms.twig' as forms %}

      <div id="{{ 'config-options'|namespaceInputId }}">
        <section class="btngroup btngroup--exclusive small" aria-label="{{ 'CKEditor config option mode'|t('ckeditor') }}">
          {{ tag('button', {
            type: 'button',
            class: ['btn', 'small', configMode == 'json' ? 'active']|filter,
            aria: {pressed: configMode == 'json' ? 'true'}|filter,
            data: {mode: 'json'},
            text: 'JSON',
          }) }}
          {{ tag('button', {
            type: 'button',
            class: ['btn', 'small', configMode == 'js' ? 'active' : null]|filter,
            aria: {pressed: configMode == 'js' ? 'true'}|filter,
            data: {mode: 'js'},
            text: 'JavaScript',
          }) }}
          {{ tag('button', {
            type: 'button',
            class: ['btn', 'small', configMode == 'file' ? 'active' : null]|filter,
            aria: {pressed: configMode == 'file' ? 'true'}|filter,
            data: {mode: 'file'},
            text: 'File',
          }) }}
        </section>
        <input type="hidden" id="{{ 'config-options-mode'|namespaceInputId }}" name="configMode" value="{{ configMode }}">
      </div>

      {% tag 'div' with {
        id: 'config-options-json-container'|namespaceInputId,
        class: {
          'mt-s': true,
          hidden: configMode != 'json',
          disabled: readOnly,
        }|filter|keys,
      } %}
        {{ tag('textarea', {
          id: 'config-options-json'|namespaceInputId,
          name: 'json',
          class: ['text', 'fullwidth'],
          rows: 10,
          text: field.json ?? "{\n  \n}",
          data: {
            'code-editor': 'ckeditor:EditorConfigJson',
            'code-editor-language': 'json',
          },
        }) }}
      {% endtag %}

      {% tag 'div' with {
        id: 'config-options-js-container'|namespaceInputId,
        class: {
          'mt-s': true,
          hidden: configMode != 'js',
          disabled: readOnly,
        }|filter|keys,
      } %}
        {{ tag('textarea', {
          id: 'config-options-js'|namespaceInputId,
          name: 'js',
          class: ['text', 'fullwidth'],
          rows: 10,
          text: field.js ?? "return {\n  \n}",
          data: {
            'code-editor': 'ckeditor:EditorConfigJs',
            'code-editor-language': 'javascript',
          },
        }) }}
      {% endtag %}

      {% tag 'div' with {
        id: 'config-options-file-container'|namespaceInputId,
        class: {
          'mt-s': true,
          hidden: configMode != 'file',
          disabled: readOnly,
        }|filter|keys,
      } %}
        {% if jsFileOptions|length %}
          <p class="light mb-xs">
            {{ 'Choose a JS/JSON file within `config/craft/ckeditor/`.'|t('ckeditor')|md(inlineOnly=true) }}
          </p>
          {{ forms.select({
            id: 'config-options-file'|namespaceInputId,
            name: 'jsFile',
            options: jsFileOptions,
            value: field.jsFile,
          }) }}
        {% else %}
          <p class="warning with-icon">
            {{ 'No JS/JSON files exist within `config/craft/ckeditor/`.'|t('ckeditor')|md(inlineOnly=true) }}
          </p>
        {% endif %}
      {% endtag %}
    
  </div>
  {% endblock %}
{% endembed %}

{% embed '_includes/forms/field.twig' with {
  label: 'Custom Styles'|t('ckeditor'),
  instructions: 'Define CSS styles that should be registered for editors, such as [style classes]({url}).'|t('ckeditor', {
    url: 'https://ckeditor.com/docs/ckeditor5/latest/features/style.html',
  }),
  id: 'css-field'|namespaceInputId,
} %}
  {% block input %}
  <div style="min-width: 0; width: 100%;">
      {% import '_includes/forms.twig' as forms %}

      <div id="{{ 'css-options'|namespaceInputId }}">
        <section class="btngroup btngroup--exclusive small" aria-label="{{ 'CSS mode'|t('ckeditor') }}">
          {{ tag('button', {
            type: 'button',
            class: ['btn', 'small', cssMode == 'css' ? 'active']|filter,
            aria: {pressed: cssMode == 'css' ? 'true'}|filter,
            data: {mode: 'css'},
            text: 'CSS',
          }) }}
          {{ tag('button', {
            type: 'button',
            class: ['btn', 'small', cssMode == 'file' ? 'active' : null]|filter,
            aria: {pressed: cssMode == 'file' ? 'true'}|filter,
            data: {mode: 'file'},
            text: 'File',
          }) }}
        </section>
        <input type="hidden" id="{{ 'css-options-mode'|namespaceInputId }}" name="cssMode" value="{{ cssMode }}">
      </div>

      {% tag 'div' with {
        id: 'css-options-css-container'|namespaceInputId,
        class: {
          'mt-s': true,
          hidden: cssMode != 'css',
          disabled: readOnly,
        }|filter|keys,
      } %}
        {{ tag('textarea', {
          id: 'css-options-css'|namespaceInputId,
          name: 'css',
          class: ['text', 'fullwidth'],
          rows: 10,
          text: cssMode == 'css' ? field.css,
          data: {
            'code-editor': 'CodeEditor',
            'code-editor-language': 'css',
          },
        }) }}
      {% endtag %}

      {% tag 'div' with {
        id: 'css-options-file-container'|namespaceInputId,
        class: {
          'mt-s': true,
          hidden: cssMode != 'file',
          disabled: readOnly,
        }|filter|keys,
      } %}
        {% if cssFileOptions|length %}
          <p class="light mb-xs">
            {{ 'Choose a CSS file within `config/craft/ckeditor/`.'|t('ckeditor')|md(inlineOnly=true) }}
          </p>
          {{ forms.select({
            id: 'css-options-file'|namespaceInputId,
            name: 'cssFile',
            options: cssFileOptions,
            value: field.cssFile,
          }) }}
        {% else %}
          <p class="warning with-icon">
            {{ 'No CSS files exist within `config/craft/ckeditor/`.'|t('ckeditor')|md(inlineOnly=true) }}
          </p>
        {% endif %}
      {% endtag %}
    
  </div>
  {% endblock %}
{% endembed %}
