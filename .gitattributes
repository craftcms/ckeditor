# Do not export those files in the Composer archive (lighter dependency)
/.gitattributes export-ignore
/.gitignore export-ignore
/.lintstagedrc.json export-ignore
/.nvmrc export-ignore
/CHANGELOG.md export-ignore
/README.md export-ignore
/composer.lock export-ignore
/phpstan.neon export-ignore
/pint.json export-ignore
/.prettierrc.json export-ignore
/.prettierignore export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/tsconfig.json export-ignore
/vite.config.mts export-ignore
/resources/js/ export-ignore
/resources/assets/ckeditor/src/ export-ignore
/resources/assets/ckeditor/vite.config.js export-ignore
/resources/assets/fieldsettings/src/ export-ignore
/resources/assets/fieldsettings/vite.config.js export-ignore
/tests/ export-ignore
/.github/ export-ignore
/.husky/ export-ignore
/workbench/ export-ignore
/testbench.yaml export-ignore

# Identify generated files
/resources/assets/*/dist/** linguist-generated=true
/public/build/** linguist-generated=true

# Auto detect text files and perform LF normalization
* text=auto
