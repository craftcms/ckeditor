{
  "name": "craftcms/ckeditor",
  "description": "Edit rich text content in Craft CMS using CKEditor.",
  "type": "craft-plugin",
  "keywords": [
    "html",
    "cms",
    "craftcms",
    "ckeditor"
  ],
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Pixel & Tonic",
      "homepage": "https://pixelandtonic.com/"
    }
  ],
  "support": {
    "email": "support@craftcms.com",
    "issues": "https://github.com/craftcms/ckeditor/issues?state=open",
    "source": "https://github.com/craftcms/ckeditor",
    "docs": "https://github.com/craftcms/ckeditor/blob/6.x/README.md",
    "rss": "https://github.com/craftcms/ckeditor/commits/6.x.atom"
  },
  "require": {
    "php": "^8.5",
    "craftcms/cms": "^6.0.0",
    "craftcms/html-field": "dev-feature/craft-6",
    "embed/embed": "^4.4"
  },
  "require-dev": {
    "driftingly/rector-laravel": "^2.6.2",
    "larastan/larastan": "^3.13",
    "laravel/pint": "^1.22",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0",
    "phpstan/phpstan": "^2.1",
    "rector/rector": "^2.3",
    "vlucas/phpdotenv": "^5.5"
  },
  "autoload": {
    "psr-4": {
      "CraftCms\\Ckeditor\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CraftCms\\Ckeditor\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "check-cs": "pint --test",
    "fix-cs": "pint",
    "phpstan": "phpstan --memory-limit=1G",
    "tests": "./vendor/bin/pest --compact"
  },
  "extra": {
    "name": "CKEditor",
    "handle": "ckeditor",
    "class": "CraftCms\\Ckeditor\\Plugin",
    "documentationUrl": "https://github.com/craftcms/ckeditor/blob/6.x/README.md"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true,
      "php-http/discovery": false
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://composer.craftcms.com",
      "canonical": false
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true
}
